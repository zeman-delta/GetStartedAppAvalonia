<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GetStartedApp.ViewModels"
        xmlns:models="using:GetStartedApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="GetStartedApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Todo App"
        Width="500" MinHeight="200">

    <Window.Styles>
        <Style Selector="TextBlock.completed">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">

        <!-- Input row -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Add"
                    Command="{Binding AddItemCommand}"
                    Margin="8,0,0,0"/>
            <TextBox Text="{Binding NewItemContent}"
                     Watermark="New task...">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddItemCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <!-- Todo list -->
        <ScrollViewer>
            <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <DockPanel Margin="0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="X"
                                    Command="{ReflectionBinding DataContext.RemoveItemCommand, ElementName=ItemsList}"
                                    CommandParameter="{Binding}"/>
                            <CheckBox IsChecked="{Binding Completed}"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Classes.completed="{Binding Completed}"
                                       ToolTip.Tip="{Binding Description}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
